# Omarchy-style keyboard layer for macOS.
# App launchers use cmd + shift. Window and workspace controls use alt.

# Launch/focus apps
cmd + shift - return : "$HOME/.config/yabai/focus_or_open_app.sh" terminal "Ghostty"
cmd + shift - b : "$HOME/.config/yabai/focus_or_open_app.sh" web "Zen"
cmd + shift - m : "$HOME/.config/yabai/focus_or_open_app.sh" comms "Microsoft Outlook" "Mail"
cmd + shift - w : "$HOME/.config/yabai/focus_or_open_app.sh" comms "Microsoft Teams" "WhatsApp"
cmd + shift - s : "$HOME/.config/yabai/focus_or_open_app.sh" media "Spotify"
cmd + shift - o : "$HOME/.config/yabai/focus_or_open_app.sh" notes "Obsidian"
cmd + shift - k : "$HOME/.config/yabai/focus_or_open_app.sh" calendar "Calendar"
cmd + shift - 0x2C : osascript -e 'tell application "Finder" to make new Finder window' -e 'tell application "Finder" to activate'

# New app windows
alt + shift - return : open -na "Ghostty"
alt + shift - b : "$HOME/.config/yabai/open_zen_window.sh"

# Focus windows
alt - h : yabai -m window --focus west 2>/dev/null || yabai -m space --focus prev 2>/dev/null
alt - j : yabai -m window --focus south 2>/dev/null
alt - k : yabai -m window --focus north 2>/dev/null
alt - l : yabai -m window --focus east 2>/dev/null || yabai -m space --focus next 2>/dev/null

# Swap windows
alt + shift - h : yabai -m window --swap west 2>/dev/null
alt + shift - j : yabai -m window --swap south 2>/dev/null
alt + shift - k : yabai -m window --swap north 2>/dev/null
alt + shift - l : yabai -m window --swap east 2>/dev/null

# Resize windows
alt + ctrl - h : yabai -m window --resize left:-80:0 2>/dev/null || yabai -m window --resize right:-80:0 2>/dev/null
alt + ctrl - j : yabai -m window --resize bottom:0:80 2>/dev/null || yabai -m window --resize top:0:80 2>/dev/null
alt + ctrl - k : yabai -m window --resize top:0:-80 2>/dev/null || yabai -m window --resize bottom:0:-80 2>/dev/null
alt + ctrl - l : yabai -m window --resize right:80:0 2>/dev/null || yabai -m window --resize left:80:0 2>/dev/null

# Workspace navigation
alt - 1 : yabai -m space --focus 1 2>/dev/null
alt - 2 : yabai -m space --focus 2 2>/dev/null
alt - 3 : yabai -m space --focus 3 2>/dev/null
alt - 4 : yabai -m space --focus 4 2>/dev/null
alt - 5 : yabai -m space --focus 5 2>/dev/null
alt - 6 : yabai -m space --focus 6 2>/dev/null
alt - 7 : yabai -m space --focus 7 2>/dev/null
alt - 8 : yabai -m space --focus 8 2>/dev/null
alt - 9 : yabai -m space --focus 9 2>/dev/null
alt - tab : yabai -m space --focus recent 2>/dev/null

# Move all managed windows to their default workspaces.
alt + shift - d : "$HOME/.config/yabai/move_windows_to_default_spaces.sh"
alt - d : "$HOME/.config/yabai/move_to_default_space.sh"
alt + shift - 1 : yabai -m window --space 1 2>/dev/null; yabai -m space --focus 1 2>/dev/null
alt + shift - 2 : yabai -m window --space 2 2>/dev/null; yabai -m space --focus 2 2>/dev/null
alt + shift - 3 : yabai -m window --space 3 2>/dev/null; yabai -m space --focus 3 2>/dev/null
alt + shift - 4 : yabai -m window --space 4 2>/dev/null; yabai -m space --focus 4 2>/dev/null
alt + shift - 5 : yabai -m window --space 5 2>/dev/null; yabai -m space --focus 5 2>/dev/null
alt + shift - 6 : yabai -m window --space 6 2>/dev/null; yabai -m space --focus 6 2>/dev/null
alt + shift - 7 : yabai -m window --space 7 2>/dev/null; yabai -m space --focus 7 2>/dev/null
alt + shift - 8 : yabai -m window --space 8 2>/dev/null; yabai -m space --focus 8 2>/dev/null
alt + shift - 9 : yabai -m window --space 9 2>/dev/null; yabai -m space --focus 9 2>/dev/null

# Window/layout controls
alt - q : yabai -m window --close
alt - f : yabai -m window --toggle zoom-fullscreen
alt + shift - f : yabai -m window --toggle float --grid 4:4:1:1:2:2
alt - c : if [ "$(yabai -m query --windows --window | jq -r '."is-floating"')" = "true" ]; then yabai -m window --toggle float; else yabai -m window --toggle float; yabai -m window --grid 5:5:1:1:3:3; fi
alt - s : yabai -m window --toggle split
alt - e : yabai -m space --balance
alt - r : yabai -m space --rotate 90
alt - y : yabai -m space --mirror y-axis
alt + shift - r : yabai --restart-service; sketchybar --reload

# Service mode: enter with alt + shift + ;, leave with escape.
:: service
alt + shift - 0x29 ; service
service < escape ; default
service < r : yabai -m space --balance; skhd -k "escape"
service < f : yabai -m window --toggle float --grid 4:4:1:1:2:2; skhd -k "escape"
service < c : yabai -m window --grid 4:4:1:1:2:2; skhd -k "escape"
service < backspace : yabai -m query --windows --space | jq -r '.[] | select(."has-focus" == false) | .id' | while read -r id; do yabai -m window "$id" --close; done; skhd -k "escape"
service < h : yabai -m window --warp west 2>/dev/null; skhd -k "escape"
service < j : yabai -m window --warp south 2>/dev/null; skhd -k "escape"
service < k : yabai -m window --warp north 2>/dev/null; skhd -k "escape"
service < l : yabai -m window --warp east 2>/dev/null; skhd -k "escape"
