# Omarchy-style keyboard layer for macOS.
# App launchers use cmd + shift. Window and workspace controls use alt.

# Launch/focus apps
cmd + shift - return : yabai -m rule --remove startup_Ghostty_terminal 2>/dev/null; yabai -m space --focus 1; open -a "Ghostty"
cmd + shift - b : open -a "Zen"
cmd + shift - m : open -a "Mail"
cmd + shift - w : open -a "WhatsApp"
cmd + shift - s : open -a "Spotify"
cmd + shift - o : open -a "Obsidian"
cmd + shift - 0x2C : open -a "Finder"

# New app windows
alt + shift - return : yabai -m rule --remove startup_Ghostty_terminal 2>/dev/null; open -na "Ghostty"
alt + shift - b : /Applications/Zen.app/Contents/MacOS/zen --new-window
alt + shift - f : open -na "Finder"

# Focus windows
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# Swap windows
alt + shift - h : yabai -m window --swap west
alt + shift - j : yabai -m window --swap south
alt + shift - k : yabai -m window --swap north
alt + shift - l : yabai -m window --swap east

# Resize windows
alt + ctrl - h : yabai -m window --resize left:-80:0 || yabai -m window --resize right:-80:0
alt + ctrl - j : yabai -m window --resize bottom:0:80 || yabai -m window --resize top:0:80
alt + ctrl - k : yabai -m window --resize top:0:-80 || yabai -m window --resize bottom:0:-80
alt + ctrl - l : yabai -m window --resize right:80:0 || yabai -m window --resize left:80:0

# Workspace navigation
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
alt - tab : yabai -m space --focus recent
alt - left : yabai -m space --focus prev
alt - right : yabai -m space --focus next

# Move windows to workspaces
alt + shift - 1 : yabai -m window --space 1; yabai -m space --focus 1
alt + shift - 2 : yabai -m window --space 2; yabai -m space --focus 2
alt + shift - 3 : yabai -m window --space 3; yabai -m space --focus 3
alt + shift - 4 : yabai -m window --space 4; yabai -m space --focus 4
alt + shift - 5 : yabai -m window --space 5; yabai -m space --focus 5
alt + shift - 6 : yabai -m window --space 6; yabai -m space --focus 6
alt + shift - 7 : yabai -m window --space 7; yabai -m space --focus 7
alt + shift - 8 : yabai -m window --space 8; yabai -m space --focus 8
alt + shift - 9 : yabai -m window --space 9; yabai -m space --focus 9

# Window/layout controls
alt - q : yabai -m window --close
alt - f : yabai -m window --toggle zoom-fullscreen
alt + shift - f : yabai -m window --toggle float --grid 4:4:1:1:2:2
alt - c : if [ "$(yabai -m query --windows --window | jq -r '."is-floating"')" = "true" ]; then yabai -m window --toggle float; else yabai -m window --toggle float; yabai -m window --grid 5:5:1:1:3:3; fi
alt - s : yabai -m window --toggle sticky
alt - e : yabai -m space --balance
alt - r : yabai -m space --rotate 90
alt - y : yabai -m space --mirror y-axis
alt + shift - r : yabai --restart-service; sketchybar --reload

# Service mode: enter with alt + shift + ;, leave with escape.
:: service
alt + shift - 0x29 ; service
service < escape ; default
service < r : yabai -m space --balance; skhd -k "escape"
service < f : yabai -m window --toggle float --grid 4:4:1:1:2:2; skhd -k "escape"
service < c : yabai -m window --grid 4:4:1:1:2:2; skhd -k "escape"
service < backspace : yabai -m query --windows --space | jq -r '.[] | select(."has-focus" == false) | .id' | xargs -I{} yabai -m window {} --close; skhd -k "escape"
service < alt + shift - h : yabai -m window --warp west; skhd -k "escape"
service < alt + shift - j : yabai -m window --warp south; skhd -k "escape"
service < alt + shift - k : yabai -m window --warp north; skhd -k "escape"
service < alt + shift - l : yabai -m window --warp east; skhd -k "escape"
