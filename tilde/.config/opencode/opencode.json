{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "shell": "/bin/zsh",
  "default_agent": "build",
  "snapshots": true,
  "formatter": false,
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 20000
  },
  "warming": true,
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 4000,
      "max_height": 4000,
      "max_base64_bytes": 10485760
    }
  },
  "websearch": {
    "provider": "random"
  },
  "worktree": {
    "directory": ".lane/trees"
  },
  "plugins": [
    "-herdr.*"
  ],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "grounded-docs": {
        "type": "remote",
        "url": "http://127.0.0.1:6280/mcp"
      }
    }
  }
}
