{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "attention": {
    "notifications": true,
    "sound": false,
    "volume": 0.5,
    "sound_pack": "opencode.default"
  },
  "tabs": {
    "enabled": true,
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "numbers"
  },
  "animations": true
}
