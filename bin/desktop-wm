#!/usr/bin/env sh

set -eu

# launchd supplies a minimal PATH. Keep the desktop controller usable at login and
# from an interactive shell without depending on shell initialization.
PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.dotfiles/bin"
export PATH

usage() {
  printf 'usage: desktop-wm {omniwm|stop|reload|status}\n' >&2
  exit 2
}

refresh_bar() {
  command -v sketchybar >/dev/null 2>&1 || return 0
  sketchybar --reload
  sketchybar --trigger workspace_update
}

restart_skhd() {
  command -v skhd >/dev/null 2>&1 || return 0
  if pgrep -x skhd >/dev/null; then
    skhd --restart-service
  else
    skhd --start-service
  fi

  # Homebrew replacements can invalidate macOS Accessibility approval. Do not
  # turn that expected denial into a failed desktop startup; skhd logs the
  # actionable reason and exits without leaving an event tap behind.
  sleep 1
  if ! pgrep -x skhd >/dev/null; then
    printf '%s\n' 'desktop-wm: skhd did not start; re-grant Accessibility access' >&2
  fi
}

stop_skhd() {
  if command -v skhd >/dev/null 2>&1; then
    skhd --stop-service >/dev/null 2>&1 || true
  fi
  pkill -TERM -x skhd >/dev/null 2>&1 || true
}

stop_omniwm_watcher() {
  pid_file="$HOME/Library/Caches/com.sem.desktop-wm/omniwm-sketchybar.pid"
  [ -f "$pid_file" ] || return 0
  pid=$(cat "$pid_file" 2>/dev/null || true)
  case "$pid" in
    ''|*[!0-9]*) ;;
    *) kill "$pid" >/dev/null 2>&1 || true ;;
  esac
  rm -f "$pid_file"
}

start_omniwm_watcher() {
  stop_omniwm_watcher
  command -v omniwmctl >/dev/null 2>&1 || return 0
  command -v sketchybar >/dev/null 2>&1 || return 0

  cache_dir="$HOME/Library/Caches/com.sem.desktop-wm"
  log_dir="$HOME/Library/Logs"
  mkdir -p "$cache_dir" "$log_dir"
  nohup "$HOME/.config/omniwm/watch_sketchybar.sh" \
    >>"$log_dir/omniwm-sketchybar.log" 2>&1 &
  printf '%s\n' "$!" >"$cache_dir/omniwm-sketchybar.pid"
}

stop_omniwm() {
  stop_omniwm_watcher
  pkill -TERM -x OmniWM >/dev/null 2>&1 || true
  attempts=0
  while pgrep -x OmniWM >/dev/null && [ "$attempts" -lt 50 ]; do
    sleep 0.1
    attempts=$((attempts + 1))
  done
}

start_omniwm() {
  "$HOME/.config/omniwm/build_set_window_frame.sh"
  restart_skhd

  # OmniWM requires separate Spaces. A value of 0 means displays are not
  # spanned into one Space; the current machine already uses this setting.
  defaults write com.apple.spaces spans-displays -bool false
  open -gja OmniWM
  start_omniwm_watcher
}

stop_all() {
  # Release every process that owns a global input or window-management event
  # tap. This is also the remote recovery command if local input becomes stuck.
  stop_skhd
  stop_omniwm
}

reload_active() {
  if pgrep -x OmniWM >/dev/null; then
    restart_skhd
    start_omniwm_watcher
  fi
  refresh_bar
}

case "${1:-}" in
  omniwm)
    start_omniwm
    refresh_bar
    ;;
  stop)
    stop_all
    ;;
  reload)
    reload_active
    ;;
  status)
    printf 'active: '
    if pgrep -x OmniWM >/dev/null; then
      printf 'omniwm\n'
    else
      printf 'none\n'
    fi
    printf 'OmniWM: '
    pgrep -x OmniWM >/dev/null && printf 'running\n' || printf 'stopped\n'
    printf 'skhd: '
    pgrep -x skhd >/dev/null && printf 'running\n' || printf 'stopped\n'
    ;;
  *) usage ;;
esac
